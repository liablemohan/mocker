# ExamDesk Environment Variables
# --------------------------------
# Copy this file to .env and fill in your values.
# Then run: export $(cat .env | xargs)  (macOS/Linux)
# Or set them in your system/Docker environment.

# Required: Your Gemini API Key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Flask host/port (defaults shown)
# FLASK_HOST=0.0.0.0
# FLASK_RUN_PORT=5050
